# ==============================================================================
# APP VARIABLES (used by backend, frontend, and docker compose)
# !!! REMOVE ALL COMMENTS IN REAL .ENV FILE !!!
# !!! DO NOT FORGET TO ADD THESE VARIABLES TO GITHUB VPS-DEPLOY.YAML !!!
# ==============================================================================
# Single source of truth for all services. Copy this file to `.env` and fill values.
# VPS deploy: `.github/workflows/vps-deploy.yaml` generates `.env` from GitHub
# secrets on each deploy, so Secrets are the source of truth there.

# [OPTIONAL] Enables development mode in application.
# If not set, defaults to false
DEVELOPMENT=false

# [REQUIRED] Async SQLAlchemy database URL for backend.
# Switch engines by changing this value only (plus aiosqlite for local SQLite).
#
# Local development (SQLite; relative path is resolved from repo root):
#   DATABASE_URL=sqlite+aiosqlite:///../local.db
# Local db is assumed to be located in the root of the project.
#
# Docker Compose / production (Postgres; host must be the compose service name):
#   DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB_NAME
#
# Example filled-in Compose URL (must match POSTGRES_* below):
#   DATABASE_URL=postgresql+asyncpg://your_username:your_super_secret_password@db:5432/your_database_name
DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB_NAME

# [OPTIONAL] Host port mapped to frontend nginx container port 8080. If not set, defaults to 8100.
# Usable when you run multiple apps on the same server.
PORT=8100


# ==============================================================================
# ADMIN / SESSION (admin panel on the backend)
# Used by backend/app/admin and SessionMiddleware in backend/app/api.py.
# Generate ADMIN_PASSWORD_HASH from backend/:
#   uv run python scripts/generate_password_hash.py
# ==============================================================================

# [REQUIRED] Secret for signing session cookies and admin CSRF.
# Use a long random string. Never reuse across environments or commit real values.
# Example local generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# [REQUIRED] Single admin username for the admin login form.
ADMIN_USERNAME=admin

# [REQUIRED] bcrypt hash of the admin password (not the plain password).
# Example below is bcrypt("changeme123") — replace before any real deploy.
# Generate your own: uv run python scripts/generate_password_hash.py
# Write every $ as $$. Compose otherwise treats $... as a variable name
# and the hash that reaches the container is blank.
ADMIN_PASSWORD_HASH=$$2b$$12$$9wxUmvz4ojGsomemorebyteshere


# ==============================================================================
# POSTGRES VARIABLES (used by db service in compose.yaml in prod)
# [REQUIRED FOR RUNNING WITH DOCKER COMPOSE]
# Must match DATABASE_URL.
# VPS deploy: `.github/workflows/vps-deploy.yaml` generates `.env` from GitHub
# secrets on each deploy, so Secrets are the source of truth there.
# ==============================================================================

# [REQUIRED FOR RUNNING WITH DOCKER COMPOSE]
# Database name created by postgres container on first init.
# Used in: compose.yaml -> services.db.environment.POSTGRES_DB
POSTGRES_DB=your_database_name

# [REQUIRED FOR RUNNING WITH DOCKER COMPOSE]
# Postgres username for container initialization and healthcheck.
# Used in:
#   - compose.yaml -> services.db.environment.POSTGRES_USER
#   - compose.yaml -> services.db.healthcheck (pg_isready -U ...)
# Must be provided or compose will fail with "POSTGRES_USER is required".
POSTGRES_USER=your_username

# [REQUIRED FOR RUNNING WITH DOCKER COMPOSE]
# Postgres password for container initialization.
# Used in: compose.yaml -> services.db.environment.POSTGRES_PASSWORD
# Must be provided or compose will fail with "POSTGRES_PASSWORD is required".
POSTGRES_PASSWORD=your_super_secret_password


# ==============================================================================
# S3 / MINIO VARIABLES (used by S3-compatible storage service and backend)
# ==============================================================================

# [REQUIRED]
# Public URL of the S3 API as seen by the browser.
# Compose maps it to MINIO_SERVER_URL (MinIO reads that name).
# A path prefix (/s3/) is fine: the backend signs the origin only, then
# inserts the prefix. Nginx strips /s3/ before MinIO checks the signature.
# Trailing slash matters for MinIO. On Yandex/AWS set the public bucket URL.
# Local Compose example: http://localhost:8100/s3/
S3_PUBLIC_URL=https://your-domain.com/s3/

# [OPTIONAL] SigV4 region. Defaults to ru-central1 (Yandex Moscow).
# AWS us-east-1 is the other common value. The region is part of the
# signature, so MinIO is set to the same value (MINIO_REGION_NAME).
S3_REGION=ru-central1

# [REQUIRED WHILE RUNNING MINIO]
# Public URL of the MinIO web console. MinIO reads this name directly
# and uses it to build redirects behind a reverse proxy.
# Must end with a trailing slash.
# Drop this when you stop running MinIO: Yandex/AWS have no self-hosted console.
MINIO_BROWSER_REDIRECT_URL=https://your-domain.com/minio/ui/

# [OPTIONAL] Defaults to http://minio:9000.
# Internal endpoint the backend uses to upload files.
# Must be the compose service name (not localhost) — the backend container
# reaches MinIO over the Docker network. Do not change unless renaming the
# compose service.
S3_ENDPOINT_URL=http://minio:9000

# [REQUIRED] S3 access key. One value for both sides:
#   - backend boto3 client
#   - MinIO root user (compose maps it to MINIO_ROOT_USER; MinIO reads that name)
# When migrating to Yandex/AWS, this becomes the cloud access key ID
# and the minio service is no longer started.
S3_ACCESS_KEY=minioadmin

# [REQUIRED] S3 secret key. One value for both sides:
#   - backend boto3 client
#   - MinIO root password (compose maps it to MINIO_ROOT_PASSWORD)
# Use a long random string, never commit real values.
# Example local generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When migrating to Yandex/AWS, this becomes the cloud secret access key.
S3_SECRET_KEY=change-me-to-a-long-random-string

# [REQUIRED] Bucket name for post attachments. Created automatically by the
# backend on startup if it does not exist. Used by both upload and presigned URL.
S3_BUCKET=blog-media


# ==============================================================================
# GITHUB ACTIONS SECRETS (used by .github/workflows/vps-deploy.yaml)
# !!! DO NOT FORGET TO ADD THESE VARIABLES TO GITHUB VPS-DEPLOY.YAML !!!
# This is how your GitHub Repository Secrets should look like
# for successful VPS deploys:
# ==============================================================================
# SERVER_HOST       -> VPS hostname or IP for SSH. [REQUIRED]
# SERVER_USER       -> SSH username on VPS. [REQUIRED]
# SSH_PRIVATE_KEY   -> Private key used by appleboy/ssh-action. [REQUIRED]
# SSH_PASSPHRASE    -> Passphrase for SSH private key (if key is encrypted). [REQUIRED]
# PORT                        -> Host port mapped to frontend container port 8080. Defaults to 8100. [OPTIONAL]
# DEVELOPMENT                 -> Enables development mode in application. Defaults to false. [OPTIONAL]
# DATABASE_URL                -> Async SQLAlchemy database URL for backend. [REQUIRED]
# SECRET_KEY                  -> Signs session cookies / admin CSRF. Long random string. [REQUIRED]
# ADMIN_USERNAME              -> Admin panel login username. [REQUIRED]
# ADMIN_PASSWORD_HASH         -> bcrypt hash of admin password (from generate_password_hash.py). [REQUIRED]
# POSTGRES_DB                 -> Database name created by postgres container on first init. [REQUIRED]
# POSTGRES_USER               -> Postgres username for container initialization and healthcheck. [REQUIRED]
# POSTGRES_PASSWORD           -> Postgres password for container initialization. [REQUIRED]
# S3_PUBLIC_URL               -> Public URL of the S3 API as seen by the browser (trailing slash). [REQUIRED]
# S3_REGION                   -> SigV4 region. Defaults to ru-central1 (Yandex Moscow). [OPTIONAL]
# MINIO_BROWSER_REDIRECT_URL  -> Public URL of the MinIO console (trailing slash). Drop when leaving MinIO. [REQUIRED]
# S3_ENDPOINT_URL             -> Internal S3 endpoint for backend. Defaults to http://minio:9000. [OPTIONAL]
# S3_ACCESS_KEY               -> S3 access key. Also the MinIO root user. [REQUIRED]
# S3_SECRET_KEY               -> S3 secret key. Also the MinIO root password. [REQUIRED]
# S3_BUCKET                   -> Bucket name for post attachments. [REQUIRED]
