# Dev image: dependencies live in /opt/venv, source is bind-mounted at /app.
# A dependency change needs an image rebuild. Code changes do not.
FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.11 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /opt/backend

COPY backend/pyproject.toml backend/uv.lock ./

# Dependencies only. The app itself is the bind-mounted source, imported
# from /app, so it must not be installed into the venv from this directory.
RUN uv sync --frozen --no-install-project

WORKDIR /app

EXPOSE 8080

CMD ["fastapi", "dev", "app/api.py", "--host", "0.0.0.0", "--port", "8080", "--reload-dir", "app"]
