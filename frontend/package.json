{
  "name": "Fast_API-React_template_frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Simple template for Fast Api backend and React frontend fullstack project",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint . && prettier --check . && stylelint \"app/**/*.{css,scss}\" --allow-empty-input",
    "lint:fix": "eslint . --fix && prettier --write . && stylelint \"app/**/*.{css,scss}\" --fix --allow-empty-input",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-react": "^0.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.10.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
