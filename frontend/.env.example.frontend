# Frontend-only variables. Copy this file to `frontend/.env`.
#
# DO NOT put secrets here. Vite inlines every VITE_* value into the client bundle.
# These values cannot be changed after build.
# Variables can also be passed in shell. Shell variables have higher priority than .env file.
#
# Custom keys MUST start with VITE_ or they are ignored.
# Vite already provides these without listing them in this file:
#   import.meta.env.DEV       boolean — development (`npm run dev`)
#   import.meta.env.PROD      boolean — production (opposite of DEV)
#   import.meta.env.MODE      string  — current Vite mode
#   import.meta.env.BASE_URL  string  — Vite `base` config
#   import.meta.env.SSR       boolean — server render (false in this CSR app)
#
# See https://vite.dev/guide/env-and-mode

# [OPTIONAL] HTML lang attribute. If unset, defaults to ru-RU.
VITE_HTML_LANG=ru-RU
